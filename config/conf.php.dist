<?php
/**
 * Agora Configuration File
 *
 * IMPORTANT: Do NOT edit this file.
 *
 * To configure Agora, create a file:
 *   var/config/agora/conf.php
 *
 * This file serves as a template showing available configuration options.
 * Your var/config/agora/conf.php will override these defaults.
 *
 * Strings should be enclosed in 'quotes'.
 * Integers should be given literally (without quotes).
 * Boolean values may be true or false (never quotes).
 *
 * Generated from conf.xml on 2026-04-04
 */

// ----------------------------------------------------------------------
// Forum Settings
// ----------------------------------------------------------------------

// Enable attachments in forums: 1 (yes), 0 (forum specific), -1 (no)
$conf['forums']['enable_attachments'] = 0;

// Require users to enter a CAPTCHA verification string with each message to protect against abuse
$conf['forums']['captcha'] = 'true';
// Path to a Figlet font file for CAPTCHA text rendering
$conf['forums']['figlet_font'] = '/usr/share/games/figlet/fonts/big.flf';


// ----------------------------------------------------------------------
// Thread Settings
// ----------------------------------------------------------------------

// Track message views; threads exceeding the view threshold (set in prefs) are marked HOT
$conf['threads']['track_views'] = true;

// Store messages in per-scope tables (requires creating agora_messages_SCOPE tables manually)
$conf['threads']['split'] = false;


// ----------------------------------------------------------------------
// Avatar Settings
// ----------------------------------------------------------------------

// Enable avatar support
$conf['avatar']['allow_avatars'] = 'true';
// Allowed avatar file extensions, semicolon-separated
$conf['avatar']['allowed_extensions'] = 'gif;jpg;jpeg;png';
// Allow users to pick from a VFS-stored avatar gallery
$conf['avatar']['enable_gallery'] = 'true';
// Number of avatars per row in the gallery view
$conf['avatar']['avatars_per_row'] = 5;
// Number of rows per page in the gallery view
$conf['avatar']['rows_per_page'] = 3;
// Allow users to upload avatar images from their computer to VFS
$conf['avatar']['enable_uploads'] = true;
// Allow users to link to an external avatar image URL
$conf['avatar']['enable_external'] = true;
// Perform dimension and file-size validation on avatars (large performance impact on some servers)
$conf['avatar']['enable_image_tests'] = 'true';
// Maximum avatar height in pixels
$conf['avatar']['max_height'] = 80;
// Maximum avatar width in pixels
$conf['avatar']['max_width'] = 80;
// Maximum avatar file size in kilobytes
$conf['avatar']['max_size'] = 8;


